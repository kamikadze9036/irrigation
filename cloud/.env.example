# Heslo pro přihlášení do webu (zvol si vlastní, silné heslo)
SITE_PASSWORD=

# Náhodný dlouhý řetězec pro podepisování přihlašovací session.
# Vygeneruj např.: openssl rand -hex 32
AUTH_SECRET=

# Tajný token, kterým se ESP32 prokazuje appce (a appka ESP32 nedůvěřuje bez něj).
# Musí být IDENTICKÝ s CLOUD_DEVICE_TOKEN v config.h na ESP32.
# Vygeneruj např.: openssl rand -hex 32
DEVICE_TOKEN=

# Vyplní se automaticky při přidání Upstash/KV integrace ve Vercel dashboardu —
# není potřeba nastavovat ručně, pokud appku propojíš přes marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
